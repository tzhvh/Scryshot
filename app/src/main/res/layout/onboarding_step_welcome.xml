<?xml version="1.0" encoding="utf-8"?>
<!-- ADR 0008 §3.1 — what the app does and the privacy stance, in three lines. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/onboarding_content_background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/common_padding_24dp">

            <TextView
                style="@style/OnboardingStepLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_welcome_step_label" />

            <TextView
                android:id="@+id/title"
                style="@style/OnboardingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_padding_8dp"
                android:text="@string/setup_welcome_title" />

            <TextView
                style="@style/OnboardingLead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_padding_16dp"
                android:text="@string/setup_welcome_point_1" />

            <TextView
                style="@style/OnboardingLead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_padding_8dp"
                android:text="@string/setup_welcome_point_2" />

            <TextView
                style="@style/OnboardingLead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/common_padding_8dp"
                android:text="@string/setup_welcome_point_3" />

        </LinearLayout>

    </ScrollView>

    <!-- Full-width pinned action bar — the prototype vocabulary's
         momentum-carrying element (ADR 0008 §Design system). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/grey20" />

        <Button
            android:id="@+id/action_button"
            style="@style/OnboardingPrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/common_padding_16dp"
            android:text="@string/setup_action_get_started" />

    </LinearLayout>

</LinearLayout>
